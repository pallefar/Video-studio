<?xml version="1.0" encoding="UTF-8"?>
<!-- Mac dev-mode CPU worker: ffmpeg assembly, ingest, captioning, network
     jobs. Same install steps as com.studio.api.plist. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.studio.worker-cpu</string>
  <key>WorkingDirectory</key><string>/Users/you/video-studio</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/you/video-studio/.venv/bin/python</string>
    <string>worker_cpu/run.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DEV_ENGINES</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>/tmp/studio-worker-cpu.log</string>
  <key>StandardErrorPath</key><string>/tmp/studio-worker-cpu.log</string>
</dict>
</plist>
