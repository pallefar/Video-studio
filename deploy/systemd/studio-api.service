# Studio API — install: copy to /etc/systemd/system/, adjust User/paths,
# then `systemctl enable --now studio-api`. All units read the same .env
# (EnvironmentFile) so every service address flows from env, never a literal.
[Unit]
Description=AI video studio API (FastAPI)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=studio
WorkingDirectory=/opt/video-studio
EnvironmentFile=/opt/video-studio/.env
ExecStart=/opt/video-studio/.venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
