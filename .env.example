# Copy to .env and adjust. All services come from docker-compose.yml locally.
# The GPU worker must receive these via env — it never assumes localhost.
# Every Settings field (pipeline_core/settings.py) appears here; a drift
# guard in tests/test_ops.py fails when the two files disagree.

DATABASE_URL=postgresql+psycopg://avatar:avatar@localhost:5432/avatar
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatar-pipeline
S3_REGION=us-east-1

# Stock providers (M8) — a provider with no key is simply not registered.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Generation providers (M10) — same rule. fal.ai is the aggregator gateway.
FAL_API_KEY=
# ElevenLabs direct API (voice/SFX/music as network jobs). Setting the key is
# the data-egress decision: scripts/prompts are sent to ElevenLabs when used.
ELEVENLABS_API_KEY=
# Direct frontier-video APIs: OpenAI Sora and Google Veo (Gemini API key).
# Same rule — a set key is the per-provider data-egress decision.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Compose host ports: if 5432/6379/9000/9001 are taken on your machine
# (a Homebrew Postgres is the classic), scripts/setup.sh picks free ports
# automatically and writes POSTGRES_PORT / REDIS_PORT / MINIO_PORT /
# MINIO_CONSOLE_PORT plus the matching URLs above into .env. They are
# compose variables, not app settings — the app only reads the URLs.

# Ollama — Mac-friendly prompt enhancement / reverse prompting backend.
# Point at a running server (e.g. http://127.0.0.1:11434) and pick a model;
# takes precedence over QWEN_MODEL_PATH when set.
OLLAMA_URL=
OLLAMA_MODEL=qwen3:4b

# YouTube publish (M6) — OAuth refresh-token flow. Unconfigured -> the
# publish stage waits instead of failing.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_URI=https://oauth2.googleapis.com/token

# Prompt enhancement (M18) — path to the Qwen3.5-4B GGUF; empty -> the
# deterministic heuristic enhancer.
QWEN_MODEL_PATH=

# Dev engines — placeholder TTS/lipsync/generation for machines without
# CUDA (Apple Silicon, CI). Opt-in only, never the default.
DEV_ENGINES=

# ComfyUI headless — the M10 wan-lane executor on the GPU host
# (docs/workstation.md). Empty -> local generation raises a config hint.
COMFY_URL=
COMFY_POLL_INTERVAL_S=2.0
COMFY_TIMEOUT_S=3600

# GPU rental providers (scripts/rent_gpu.sh) — a configured key lights the
# provider up in Settings and enables the /rentals usage probe. TensorDock
# needs both key and token.
VAST_API_KEY=
RUNPOD_API_KEY=
LAMBDA_API_KEY=
TENSORDOCK_API_KEY=
TENSORDOCK_API_TOKEN=
